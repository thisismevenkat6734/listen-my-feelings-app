rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================
       HELPERS
       ===================================================== */

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function optionalText(value, maxLength) {
      return value is string
        && value.size() <= maxLength;
    }

    function publicActiveFeeling(data) {
      return data.visibility == "public"
        && data.status == "active";
    }

    function connectionId(userA, userB) {
      return userA < userB
        ? userA + "_" + userB
        : userB + "_" + userA;
    }

    function connectionExists(userA, userB) {
      return exists(
        /databases/$(database)/documents/connections/$(connectionId(userA, userB))
      );
    }

    function acceptedConnection(userA, userB) {
      return connectionExists(userA, userB)
        && get(
          /databases/$(database)/documents/connections/$(connectionId(userA, userB))
        ).data.status == "accepted";
    }

    function blocked(userA, userB) {
      return exists(
        /databases/$(database)/documents/blocks/$(userA + "_" + userB)
      )
      || exists(
        /databases/$(database)/documents/blocks/$(userB + "_" + userA)
      );
    }


    /* =====================================================
       USERS
       ===================================================== */

    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "user"
        && request.resource.data.status == "active"
        && validText(
          request.resource.data.displayName,
          50
        )
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && validText(
          request.resource.data.displayName,
          50
        )
        && (
          !("bio" in request.resource.data)
          || optionalText(
            request.resource.data.bio,
            500
          )
        )
        && (
          !("mood" in request.resource.data)
          || optionalText(
            request.resource.data.mood,
            50
          )
        );

      allow delete: if false;
    }


    /* =====================================================
       FEELINGS
       ===================================================== */

    match /feelings/{feelingId} {

      allow read: if signedIn()
        && (
          publicActiveFeeling(resource.data)
          || resource.data.authorId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && validText(
          request.resource.data.text,
          2000
        )
        && validText(
          request.resource.data.authorDisplayName,
          50
        )
        && validText(
          request.resource.data.mood,
          50
        )
        && validText(
          request.resource.data.topic,
          100
        )
        && request.resource.data.visibility == "public"
        && request.resource.data.status == "active"
        && request.resource.data.understoodCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          !("hasSong" in request.resource.data)
          || request.resource.data.hasSong is bool
        )
        && (
          !("songProvider" in request.resource.data)
          || optionalText(
            request.resource.data.songProvider,
            30
          )
        )
        && (
          !("songTitle" in request.resource.data)
          || optionalText(
            request.resource.data.songTitle,
            200
          )
        )
        && (
          !("songUrl" in request.resource.data)
          || optionalText(
            request.resource.data.songUrl,
            2000
          )
        );

      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorDisplayName == resource.data.authorDisplayName
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.understoodCount == resource.data.understoodCount
        && validText(
          request.resource.data.text,
          2000
        )
        && validText(
          request.resource.data.mood,
          50
        )
        && validText(
          request.resource.data.topic,
          100
        )
        && request.resource.data.updatedAt == request.time
        && (
          !("hasSong" in request.resource.data)
          || request.resource.data.hasSong is bool
        )
        && (
          !("songProvider" in request.resource.data)
          || optionalText(
            request.resource.data.songProvider,
            30
          )
        )
        && (
          !("songTitle" in request.resource.data)
          || optionalText(
            request.resource.data.songTitle,
            200
          )
        )
        && (
          !("songUrl" in request.resource.data)
          || optionalText(
            request.resource.data.songUrl,
            2000
          )
        );

      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;


      /* ===================================================
         I UNDERSTAND
         =================================================== */

      match /understands/{userId} {

        allow read: if signedIn()
          && publicActiveFeeling(
            get(
              /databases/$(database)/documents/feelings/$(feelingId)
            ).data
          );

        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && publicActiveFeeling(
            get(
              /databases/$(database)/documents/feelings/$(feelingId)
            ).data
          )
          && !blocked(
            request.auth.uid,
            get(
              /databases/$(database)/documents/feelings/$(feelingId)
            ).data.authorId
          );

        allow delete: if signedIn()
          && request.auth.uid == userId;

        allow update: if false;
      }


      /* ===================================================
         RESPONSES
         =================================================== */

      match /responses/{responseId} {

        allow read: if signedIn()
          && publicActiveFeeling(
            get(
              /databases/$(database)/documents/feelings/$(feelingId)
            ).data
          );

        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && validText(
            request.resource.data.text,
            2000
          )
          && request.resource.data.status == "active"
          && request.resource.data.createdAt == request.time
          && publicActiveFeeling(
            get(
              /databases/$(database)/documents/feelings/$(feelingId)
            ).data
          )
          && !blocked(
            request.auth.uid,
            get(
              /databases/$(database)/documents/feelings/$(feelingId)
            ).data.authorId
          );

        allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == resource.data.status
          && validText(
            request.resource.data.text,
            2000
          );

        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }


    /* =====================================================
       CONNECTIONS
       ===================================================== */

    match /connections/{connectionId} {

      allow read: if signedIn()
        && (
          resource.data.userA == request.auth.uid
          || resource.data.userB == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userA is string
        && request.resource.data.userB is string
        && request.resource.data.userA != request.resource.data.userB
        && (
          request.resource.data.userA == request.auth.uid
          || request.resource.data.userB == request.auth.uid
        )
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !blocked(
          request.resource.data.userA,
          request.resource.data.userB
        );

      allow update: if signedIn()
        && resource.data.userA == request.resource.data.userA
        && resource.data.userB == request.resource.data.userB
        && resource.data.requesterId == request.resource.data.requesterId
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.status == "pending"
            && request.resource.data.status == "accepted"
            && request.auth.uid != resource.data.requesterId
          )
          ||
          (
            resource.data.status == "pending"
            && request.resource.data.status == "cancelled"
            && request.auth.uid == resource.data.requesterId
          )
          ||
          (
            resource.data.status == "accepted"
            && request.resource.data.status == "ended"
            && (
              resource.data.userA == request.auth.uid
              || resource.data.userB == request.auth.uid
            )
          )
        );

      allow delete: if false;
    }


    /* =====================================================
       CHATS
       ===================================================== */

    match /chats/{chatId} {

      allow read: if signedIn()
        && (
          resource.data.userA == request.auth.uid
          || resource.data.userB == request.auth.uid
        )
        && acceptedConnection(
          resource.data.userA,
          resource.data.userB
        )
        && !blocked(
          resource.data.userA,
          resource.data.userB
        );

      allow create: if signedIn()
        && request.resource.data.userA is string
        && request.resource.data.userB is string
        && request.resource.data.userA != request.resource.data.userB
        && (
          request.resource.data.userA == request.auth.uid
          || request.resource.data.userB == request.auth.uid
        )
        && acceptedConnection(
          request.resource.data.userA,
          request.resource.data.userB
        )
        && !blocked(
          request.resource.data.userA,
          request.resource.data.userB
        )
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && (
          resource.data.userA == request.auth.uid
          || resource.data.userB == request.auth.uid
        )
        && acceptedConnection(
          resource.data.userA,
          resource.data.userB
        )
        && request.resource.data.userA == resource.data.userA
        && request.resource.data.userB == resource.data.userB;

      allow delete: if false;


      /* ===================================================
         CHAT MESSAGES
         =================================================== */

      match /messages/{messageId} {

        allow read: if signedIn()
          && exists(
            /databases/$(database)/documents/chats/$(chatId)
          )
          && (
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userA == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userB == request.auth.uid
          )
          && acceptedConnection(
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userA,
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userB
          )
          && !blocked(
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userA,
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userB
          );

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && validText(
            request.resource.data.text,
            5000
          )
          && request.resource.data.createdAt == request.time
          && exists(
            /databases/$(database)/documents/chats/$(chatId)
          )
          && (
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userA == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userB == request.auth.uid
          )
          && acceptedConnection(
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userA,
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userB
          )
          && !blocked(
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userA,
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.userB
          );

        allow update: if false;
        allow delete: if false;
      }
    }


    /* =====================================================
       BLOCKS
       ===================================================== */

    match /blocks/{blockId} {

      allow read: if signedIn()
        && resource.data.blockerId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow delete: if signedIn()
        && resource.data.blockerId == request.auth.uid;

      allow update: if false;
    }


    /* =====================================================
       REPORTS
       ===================================================== */

    match /reports/{reportId} {

      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && validText(
          request.resource.data.targetId,
          200
        )
        && validText(
          request.resource.data.targetType,
          50
        )
        && validText(
          request.resource.data.reason,
          1000
        )
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && resource.data.reporterId == request.auth.uid;

      allow update: if false;
      allow delete: if false;
    }


    /* =====================================================
       REWARDED AD UNLOCKS
       ===================================================== */

    /*
     * Disabled in V1.
     */
    match /adUnlocks/{unlockId} {
      allow read, write: if false;
    }


    /* =====================================================
       SUBSCRIPTIONS
       ===================================================== */

    /*
     * Disabled in V1.
     */
    match /subscriptions/{subscriptionId} {
      allow read, write: if false;
    }


    /* =====================================================
       NOTIFICATIONS
       ===================================================== */

    /*
     * Client cannot create fake notifications.
     */
    match /notifications/{notificationId} {

      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }


    /* =====================================================
       DEFAULT DENY
       ===================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
